# Readmora Environment Variables — Copy to `.env.local` and fill in values
# NEVER commit .env.local to version control

# ────────────────────────────────────────────────
# SUPABASE
# ────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ────────────────────────────────────────────────
# GOOGLE GEMINI AI
# ────────────────────────────────────────────────
# Found in: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ────────────────────────────────────────────────
# RAZORPAY
# ────────────────────────────────────────────────
# Found in: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Public key exposed to browser (safe — no secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id

# ────────────────────────────────────────────────
# RESEND EMAIL
# ────────────────────────────────────────────────
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ────────────────────────────────────────────────
# POSTHOG ANALYTICS
# ────────────────────────────────────────────────
# Found in: https://us.posthog.com/settings/project-details
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
